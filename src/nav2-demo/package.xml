<?xml version="1.0"?>
<package format="3">
  <name>nav2-demo</name>
  <version>0.1.0</version>
  <description>One-command launch of TurtleBot3 in Gazebo with the Nav2 stack.</description>
  <maintainer email="66058398+gaminization@users.noreply.github.com">Garv Arora</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>turtlebot3_gazebo</exec_depend>
  <exec_depend>turtlebot3_navigation2</exec_depend>
  <exec_depend>nav2_bringup</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
